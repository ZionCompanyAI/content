---
import Base from "../layouts/Base.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("articles", "historia");
if (!entry) throw new Error("historia.md article entry not found in content collection");
const { Content } = await render(entry);
const { title, description, author, datePublished } = entry.data;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: {
    "@type": "Person",
    name: author,
    jobTitle: "Fundador e CEO",
    worksFor: { "@type": "Organization", name: "ZionCompanyAI" },
  },
  publisher: {
    "@type": "Organization",
    name: "ZionCompanyAI",
    url: "https://zioncompanyai.com.br",
  },
  datePublished,
  mainEntityOfPage: "https://zioncompanyai.com.br/historia/",
  inLanguage: "pt-BR",
};
---
<Base title={`${title} — ZionCompanyAI`} description={description} path="/historia/" jsonLd={jsonLd}>
  <article class="article wrap">
    <header class="article-header">
      <p class="kicker">Bastidores de engenharia</p>
      <h1>{title}</h1>
      <p class="article-meta mono">
        Por {author} · <time datetime={datePublished}>25 de maio de 2026</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="article-footer">
      <p>
        Conteúdo original publicado no repositório público
        <a href="https://github.com/MBZSolucoes/content" rel="noopener" target="_blank">MBZSolucoes/content</a>.
      </p>
      <a class="btn-primary" href="mailto:contato@mbzsolucoes.com.br">Conversar sobre o projeto</a>
    </footer>
  </article>
</Base>

<style>
  .article { padding: 5rem 0 6rem; max-width: 780px; }
  .article-header { border-bottom: 1px solid var(--border); padding-bottom: 2rem; margin-bottom: 2.5rem; }
  .article-header h1 { font-size: clamp(1.9rem, 3.6vw, 2.7rem); max-width: 22ch; }
  .article-meta { opacity: 0.6; font-size: 0.85rem; }

  .prose {
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.8rem;
    margin-bottom: 0.9rem;
    color: var(--teal);
  }
  .prose :global(h3) {
    font-size: 1.18rem;
    margin-top: 2rem;
    margin-bottom: 0.6rem;
  }
  .prose :global(p) { margin: 0 0 1.3rem; opacity: 0.92; }
  .prose :global(strong) { color: var(--teal); }
  .prose :global(em) { opacity: 0.75; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.8rem 0; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.3rem; padding-left: 1.4rem; opacity: 0.92; }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(a) { color: var(--teal); }
  .prose :global(code) {
    font-family: ui-monospace, monospace;
    background: var(--panel2);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.92em;
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .article-footer p { margin: 0; opacity: 0.6; font-size: 0.9rem; }
  .btn-primary {
    background: var(--amber);
    color: var(--ink);
    font-weight: 700;
    padding: 0.75rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
